---
import { faq } from '../data/faq';
---

<section class="faq section section--paper" id="voprosy" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 class="h2 reveal" id="faq-title">Вопросы</h2>
    <div class="faq__list">
      {
        faq.map((item) => (
          <details class="faq__item reveal">
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__sign" aria-hidden="true" />
            </summary>
            <p class="faq__a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-top: var(--space-xl);
  }

  .faq__grid {
    display: grid;
    gap: var(--space-l);
  }

  .faq__list {
    border-top: 1px solid var(--line-on-paper);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-on-paper);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.25;
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  /* Плюс, который превращается в минус. */
  .faq__sign {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .faq__sign::before,
  .faq__sign::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    background: var(--cinnabar);
    transition: transform 0.2s ease;
  }

  .faq__sign::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sign::after {
    transform: rotate(0deg);
  }

  .faq__a {
    padding-bottom: 1.4rem;
    max-width: 64ch;
    color: var(--on-paper-mute);
    text-wrap: pretty;
  }

  @media (min-width: 64rem) {
    .faq__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
