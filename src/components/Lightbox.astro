---
/**
 * Просмотр фото крупно. Кнопки с data-lightbox уже содержат <img> с srcset —
 * берём его же, чтобы не грузить отдельные файлы. <dialog> даёт фокус-ловушку,
 * закрытие по Esc и затемнение фона без самописного кода.
 */
---

<dialog class="lightbox" data-lightbox-dialog aria-label="Фото крупно">
  <form method="dialog" class="lightbox__bar">
    <button class="lightbox__close" type="submit" aria-label="Закрыть">Закрыть</button>
  </form>
  <figure class="lightbox__figure">
    <img class="lightbox__img" alt="" />
    <figcaption class="lightbox__caption"></figcaption>
  </figure>
</dialog>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(11 10 10 / 0.97);
    color: var(--on-ink);
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .lightbox__bar {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
    padding: 1rem var(--gutter);
  }

  .lightbox__close {
    padding: 0.55rem 1rem;
    background: transparent;
    border: 1px solid rgb(242 238 230 / 0.5);
    border-radius: var(--radius);
    color: var(--on-ink);
    cursor: pointer;
  }

  .lightbox__figure {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    padding: 4rem var(--gutter) 1.2rem;
    gap: 0.8rem;
  }

  .lightbox__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .lightbox__caption {
    max-width: 60ch;
    margin-inline: auto;
    text-align: center;
    font-size: var(--step--1);
    color: var(--on-ink-mute);
  }
</style>

<script>
  import { track } from '../scripts/analytics';

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const source = btn.querySelector('img');
        if (!source) return;
        img.src = source.currentSrc || source.src;
        img.srcset = source.srcset;
        img.sizes = '100vw';
        img.alt = btn.dataset.lightboxAlt ?? '';
        caption.textContent = btn.dataset.lightboxAlt ?? '';
        dialog.showModal();
        track('photo_open', { image: btn.dataset.lightbox });
      });
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  } else {
    // Без <dialog> кнопка ведёт себя как обычная картинка: ничего не открывает.
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((btn) => (btn.style.cursor = 'default'));
  }
</script>
