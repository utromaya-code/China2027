---
const links = [
  { href: '#prichiny', label: 'Почему весной' },
  { href: '#marshrut', label: 'Маршрут' },
  { href: '#programma', label: 'Программа' },
  { href: '#shangri-la', label: 'Шангри-Ла' },
  { href: '#komanda', label: 'Команда' },
  { href: '#voprosy', label: 'Вопросы' },
];
---

<div class="site-header" data-site-header>
  <div class="site-header__inner">
    <a class="brand" href="#top" aria-label="Китай 2027 — в начало страницы">
      <span class="brand__seal hanzi" aria-hidden="true">中国</span>
      <span class="brand__text">Китай <span class="brand__year">2027</span></span>
    </a>

    <nav class="site-nav" aria-label="Разделы страницы">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn site-header__cta" href="#zayavka" data-analytics="hero_cta_click">Хочу поехать</a>
  </div>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    color: var(--on-ink);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }

  .site-header.is-solid {
    background: rgb(17 16 16 / 0.96);
    border-bottom-color: var(--line-on-ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(100% - 2 * var(--gutter), 90rem);
    margin-inline: auto;
    min-height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
  }

  /* Печать: белые знаки на киновари, как оттиск цзиньши. */
  .brand__seal {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    background: var(--cinnabar);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0;
    line-height: 1;
    writing-mode: vertical-rl;
    box-shadow: inset 0 0 0 2px var(--cinnabar), inset 0 0 0 3px rgb(255 255 255 / 0.85);
  }

  .brand__text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  .brand__year {
    color: var(--on-ink-mute);
  }

  .site-nav {
    display: none;
  }

  .site-nav ul {
    display: flex;
    gap: 1.6rem;
  }

  .site-nav a {
    font-size: var(--step--1);
    text-decoration: none;
    color: var(--on-ink);
    opacity: 0.82;
    transition: opacity 0.15s ease;
  }

  .site-nav a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .site-header__cta {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: var(--step--1);
  }

  @media (min-width: 70rem) {
    .site-nav {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 40);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
