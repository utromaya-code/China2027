---
import Photo from './Photo.astro';
import { memoriesSection, memoryPhotos, reviews } from '../data/memories';
import { hasPhoto } from '../data/images';

/**
 * «Как это было»: фото и отзывы с прошлой поездки в Китай.
 * Выводится, только когда организатор передал материалы — см. memories.ts.
 */
const photos = memoryPhotos.filter((p) => hasPhoto(p.image));
const show = photos.length > 0 || reviews.length > 0;

/**
 * На телефоне сетка в две колонки. Снимок, оставшийся в ряду один (перед широким
 * кадром или в конце), растягиваем на обе колонки, чтобы не было дыры.
 */
const solo = new Set<number>();
let col = 0;
photos.forEach((p, i) => {
  if (p.wide) {
    if (col === 1) solo.add(i - 1);
    col = 0;
  } else {
    col = (col + 1) % 2;
  }
});
if (col === 1) solo.add(photos.length - 1);
---

{
  show && (
    <section class="memories section section--ink" id="kak-eto-bylo" aria-labelledby="memories-title">
      <div class="wrap">
        <header class="memories__head">
          <h2 class="h2 reveal" id="memories-title">{memoriesSection.title}</h2>
          <p class="lead memories__lead reveal">{memoriesSection.lead}</p>
        </header>

        {photos.length > 0 && (
          <ul class="memories__grid">
            {photos.map((p, i) => (
              <li class:list={['memories__item', 'reveal', p.wide && 'memories__item--wide', solo.has(i) && 'memories__item--solo']} style={`--delay:${(i % 3) * 0.08}s`}>
                <button class="memories__zoom" type="button" data-lightbox={p.image} data-lightbox-alt={p.alt} aria-label={`Открыть фото крупно: ${p.alt}`}>
                  <Photo
                    src={p.image}
                    alt={p.alt}
                    class="memories__photo"
                    focus={p.focus}
                    sizes={p.wide ? '(min-width: 82rem) 76rem, 94vw' : solo.has(i) ? '(min-width: 48rem) 30vw, 94vw' : '(min-width: 48rem) 30vw, 47vw'}
                    widths={p.wide ? [800, 1200, 1600] : [360, 560, 800, 1100]}
                  />
                </button>
              </li>
            ))}
          </ul>
        )}

        {reviews.length > 0 && (
          <ul class="reviews">
            {reviews.map((r) => (
              <li class="review reveal">
                <blockquote class="review__text">
                  <p>{r.text}</p>
                </blockquote>
                <p class="review__author">
                  {r.photo && hasPhoto(r.photo) && (
                    <Photo src={r.photo} alt="" class="review__photo" ratio="1 / 1" sizes="3.5rem" widths={[112, 168]} />
                  )}
                  <span>
                    <b>{r.name}</b>
                    {r.about && <span class="review__about">{r.about}</span>}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .memories__head {
    display: grid;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  .memories__lead {
    color: #ddd6ca;
  }

  .memories__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .memories__item--wide,
  .memories__item--solo {
    grid-column: 1 / -1;
  }

  .memories__zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .memories__zoom :global(img) {
    transition: opacity 0.2s ease;
  }

  .memories__zoom:hover :global(img) {
    opacity: 0.88;
  }

  .memories__item :global(.memories__photo) {
    aspect-ratio: 4 / 5;
  }

  .memories__item--wide :global(.memories__photo),
  .memories__item--solo :global(.memories__photo) {
    aspect-ratio: 3 / 2;
  }

  .reviews {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    margin-top: var(--space-xl);
  }

  .review__text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  .review__text p::before {
    content: '«';
  }

  .review__text p::after {
    content: '»';
  }

  .review__author {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: var(--space-m);
  }

  .review__author :global(.review__photo) {
    width: 3.5rem;
    border-radius: 50%;
  }

  .review__about {
    display: block;
    font-size: var(--step--1);
    color: var(--on-ink-mute);
  }

  @media (min-width: 48rem) {
    .memories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.6rem;
    }

    .memories__item--solo {
      grid-column: auto;
    }

    .memories__item--solo :global(.memories__photo) {
      aspect-ratio: 4 / 5;
    }

    .memories__item--wide :global(.memories__photo) {
      aspect-ratio: 21 / 9;
    }

    .reviews {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
