---
import Base from '../layouts/Base.astro';
import { trip } from '../data/trip';

/**
 * Политика обработки данных. Описывает ровно то, что делает форма:
 * имя, контакт, необязательный email, комментарий и служебные поля
 * (адрес страницы, referrer, utm-метки).
 */
const title = 'Политика конфиденциальности — Китай: путь в Шангри-Ла';
const description = 'Какие данные собирает форма заявки на путешествие по Китаю, зачем они нужны и как их удалить.';
---

<Base title={title} description={description} noindex>
  <main id="main" class="section section--paper privacy">
    <div class="wrap wrap--narrow prose">
      <h1 class="h2">Политика конфиденциальности</h1>

      <h2>Какие данные мы собираем</h2>
      <p>
        Через форму заявки: имя, контакт в Telegram или WhatsApp, адрес почты (если вы его указали) и текст
        комментария.
      </p>
      <p>
        Вместе с заявкой сохраняются служебные данные: адрес страницы, с которой она отправлена, referrer и метки
        рекламной кампании (utm), если вы перешли по ссылке с ними.
      </p>

      <h2>Зачем</h2>
      <p>
        Только чтобы ответить вам и обсудить участие в путешествии. Мы не передаём эти данные третьим лицам и не
        используем их для рассылок, на которые вы не подписывались.
      </p>

      <h2>Сколько храним</h2>
      <p>До завершения переписки об участии или до вашего запроса на удаление — смотря что наступит раньше.</p>

      <h2>Как отозвать согласие или удалить данные</h2>
      <p>
        Напишите нам в Telegram:
        <a href={trip.contacts.telegram} rel="noopener">{trip.contacts.telegramHandle}</a>. Мы удалим данные и
        подтвердим это ответным сообщением.
      </p>

      <h2>Счётчики</h2>
      <p>Сторонних счётчиков посещаемости на сайте сейчас нет. Если они появятся, мы допишем об этом здесь.</p>

      <p class="privacy__back"><a href={import.meta.env.BASE_URL}>← Вернуться на страницу путешествия</a></p>
    </div>
  </main>
</Base>

<style>
  .privacy {
    min-height: 100vh;
  }

  .prose h2 {
    margin-top: 2.2rem;
    margin-bottom: 0.6rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
  }

  .prose h1 + h2 {
    margin-top: 2.8rem;
  }

  .privacy__back {
    margin-top: 2.8rem;
  }
</style>
